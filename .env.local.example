# Supabase — copy from your project's Settings... > API
NEXT_PUBLIC_SUPABASE_URL=https://bxthrltjehnkzhjfyviu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0sls-0VKYgWQn6l1KBZogQ_QAEsRhNz

# Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI 解説（任意）----
# Anthropic の API キー（サーバー側のみ。NEXT_PUBLIC_ を付けないこと）。未設定なら、開発時はひな形の簡易解説を返し、本番では無効になります。
ANTHROPIC_API_KEY=
# 使うモデル（省略時は claude-sonnet-5-5）。費用を抑えるときは、小さいモデルに替えられます。
ANTHROPIC_MODEL=
# 1 にすると、キー未設定でもひな形の簡易解説を返します（デモ用）
EXPLAIN_MOCK=
# 0 にすると、ログイン確認なしで呼べます（開発専用。本番では無効）
EXPLAIN_REQUIRE_AUTH=
